# --- LLM (free tier friendly) ---
# Gemini 1.5 Flash free tier: 15 RPM, 1500 RPD, 1M TPM, no credit card
# Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback if Gemini is unavailable
OPENAI_API_KEY=

# --- Voice / translation (optional, degrades gracefully) ---
# Bhashini is free for Indic, register at https://bhashini.gov.in/
BHASHINI_API_KEY=

# --- Hugging Face (optional, for deepfake-probability signal model) ---
HF_TOKEN=

# --- HTTP behaviour ---
# Government sites block default python-requests UA. Set a real browser UA.
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
REQUEST_TIMEOUT_SEC=15
LOG_LEVEL=INFO

# --- Rate limit per source domain (seconds between hits) ---
SOURCE_RATE_LIMIT_SEC=1.0

# --- TTS backend: "bhashini" (if BHASHINI_API_KEY set), else "edge" ---
TTS_BACKEND=edge

# --- Default output language for /explain (en, hi, ta, bn) ---
DEFAULT_OUTPUT_LANG=hi
